# ===============================================
# FRONTEND ENVIRONMENT VARIABLES
# ===============================================
# Copy this file to .env.local for local development
# For Vercel deployment, set these in the Vercel dashboard

# ===============================================
# API CONFIGURATION (Required)
# ===============================================
# Backend API URL (browser-side, embedded at build time)
# - Development: /api (Vite proxy forwards to localhost:3001)
# - Production (Vercel): /api (Vercel edge function proxies to BACKEND_URL)
# Do NOT set this to a direct Railway/backend URL in production —
# that causes cross-origin requests and CORS failures.
VITE_API_BASE_URL=/api

# ===============================================
# VERCEL SERVER-SIDE (Required for Production)
# ===============================================
# Railway backend root URL — used by api/[...path].ts edge function.
# Set this in Vercel Dashboard > Settings > Environment Variables.
# IMPORTANT: Do NOT include /api — the proxy appends the request path.
# Example: https://your-backend.up.railway.app
# BACKEND_URL=https://your-backend.up.railway.app

# ===============================================
# SUPABASE CONFIGURATION (Required for Auth)
# ===============================================
# Get these from Supabase Dashboard > Settings > API
# URL format: https://[PROJECT-REF].supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon key (safe to expose in frontend - Row Level Security protects data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===============================================
# FEATURE FLAGS (Optional)
# ===============================================
# Enable the in-app editor for blog posts (set to "true" to enable)
VITE_ENABLE_EDITOR=false

# ===============================================
# NOTES
# ===============================================
# 1. All frontend env vars must be prefixed with VITE_ to be exposed to the app
# 2. Never expose service role keys or secrets in frontend code
# 3. VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for:
#    - Google OAuth login
#    - Email/password authentication
#    - User session management
# 4. If Supabase vars are not set, auth features will show a warning

