{
  "name": "travel-ease-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "build": "babel src-ts-backup --out-dir src --extensions \".ts,.tsx\" --copy-files",
    "start": "node server.js",
    "db:seed": "node src/seed.js",
    "db:push": "npx prisma db push",
