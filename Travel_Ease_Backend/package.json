    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@faker-js/faker": "^9.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.19.0",
    "supertest": "^6.3.3"
  }
}
