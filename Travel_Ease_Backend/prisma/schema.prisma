generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums - Using database naming convention with @map for compatibility
enum category {
  food
  drinks
  accomodation
  souvenir_shop @map("souvenir shop")
  nature
  night_life    @map("night life")
  leisure
  activities
  local_offers  @map("local offers")
}

enum participant_role {
  Admin
  Editor
  Viewer
}

enum range {
  RANGE_0_100    @map("0-100")
  RANGE_100_200  @map("100-200")
  RANGE_200_400  @map("200-400")
  RANGE_400_700  @map("400-700")
  RANGE_700_1000 @map("700-1000")
  RANGE_1000_1500 @map("1000-1500")
  RANGE_1500_PLUS @map("1500+")
}

enum status_enum {
  Draft
  Active
  Completed
  Cancelled
}

// Blog status enum for blog state machine
// Valid transitions: Draft → Published, Published → Archived, Draft → Archived
// Illegal: Archived → any other state (terminal state, no resurrection)
enum blog_status {
  Draft
  Published
  Archived
}

// User and Authentication
model User {
  user_id               Int                  @id @default(autoincrement())
  auth_id               String?              @unique @db.Uuid  // Link to Supabase auth.users.id
  first_name            String               @db.VarChar(100)
  last_name             String               @db.VarChar(100)
  email                 String               @unique @db.VarChar(100)
  contact_no            String?              @db.VarChar(50)
  password              String?              @db.VarChar  // NULL when using Supabase Auth
  auth_provider         String?              @db.VarChar(50)  // 'password', 'google', etc.
  profile_completed     Boolean?             @default(false)
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at            DateTime?            @default(now()) @updatedAt @db.Timestamp(6)

  // Relations
  activities            Activity[]
  Blog                  Blog[]
  businesses            Business[]
  business_favorites    BusinessFavorite[]
  business_reviews      BusinessReview[]
  participants          Participant[]
  travel_plans          TravelPlan[]
  travel_plan_favorites TravelPlanFavorite[]
  travel_plan_reviews   TravelPlanReview[]

  @@map("user")
}

// New Blog Content (uppercase B - UUID based)
// Blog State Machine:
//   - Draft: created but not published (status = 'Draft')
//   - Published: visible to public (status = 'Published')
//   - Archived: soft-deleted, not visible (status = 'Archived')
// Valid transitions: Draft → Published, Published → Archived, Draft → Archived
// Illegal: Archived → any other state (no resurrection)
model Blog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        Int?
  title          String      @db.VarChar(200)
  slug           String      @unique @db.VarChar(200)
  excerpt        String      @db.VarChar(500)
  content        String
  coverImageUrl  String
  category       String      @db.VarChar(100)
  isFeatured     Boolean?    @default(false)
  readingMinutes Int
  publishedAt    DateTime?   @default(now()) @db.Timestamp(6)
  author         String      @db.VarChar(100)
  status         blog_status @default(Published)
  createdAt      DateTime?   @default(now()) @db.Timestamp(6)
  updatedAt      DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  
  // Relations
  user           User?       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category], map: "idx_blog_category")
  @@index([isFeatured], map: "idx_blog_is_featured")
  @@index([publishedAt], map: "idx_blog_published_at")
  @@index([slug], map: "idx_blog_slug")
  @@index([status], map: "idx_blog_status")
  @@map("Blog")
}

// Business and Related Tables
// Price State Machine:
//   - both null: price not set
//   - only min_price set: minimum price known
//   - only max_price set: maximum price known  
//   - both set: min_price <= max_price enforced by validation
model Business {
  business_id          Int                @id @default(autoincrement())
  user_id              Int?
  name                 String             @db.VarChar(200)
  house_number         String?            @db.VarChar(300)
  street               String?            @db.VarChar(300)
  brgy                 String?            @db.VarChar(300)
  city                 String?            @db.VarChar(300)
  latitude             Float?
  longitude            Float?             @map("longtitude")
  description          String?
  rating               Decimal?           @db.Decimal(3, 1)
  google_authenticator String?            @db.VarChar(100)
  status               Boolean?           @default(false)
  picture              String?
  min_price            Int?
  max_price            Int?

  // Relations
  activities           Activity[]
  user                 User?              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  categories           BusinessCategory[]
  favorites            BusinessFavorite[]
  business_hours       BusinessHours[]
  reviews              BusinessReview[]
  menu_items           MenuItem[]

  @@index([user_id], map: "idx_business_user_id")
  @@index([status], map: "idx_business_status")
  @@map("business")
}

model BusinessCategory {
  category_id   Int          @id @default(autoincrement())
  business_id   Int?
  category_name category
  business      Business?    @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)
  price_ranges  PriceRange[]

  @@map("business_category")
}

model BusinessFavorite {
  favorite_id Int       @id @default(autoincrement())
  user_id     Int?
  business_id Int?
  business    Business? @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)
  user        User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, business_id])
  @@map("business_favorite")
}

model BusinessHours {
  id          Int       @id @default(autoincrement())
  business_id Int?
  day_of_week String?   @db.VarChar(10)
  open_time   DateTime? @db.Time(6)
  close_time  DateTime? @db.Time(6)
  business    Business? @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("business_hours")
}

model PriceRange {
  id          Int               @id @default(autoincrement())
  category_id Int?
  min_price   Int
  max_price   Int
  category    BusinessCategory? @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)

  @@map("price_range")
}

model MenuItem {
  menu_item_id Int       @id @default(autoincrement())
  business_id  Int
  name         String    @db.VarChar(200)
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  image_url    String?
  category     String?   @db.VarChar(100)
  is_available Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  // Relations
  business     Business  @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("menu_item")
}

// Travel Plan and Related Tables
model TravelPlan {
  travel_plan_id       Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(200)
  user_id              Int?
  start_date           DateTime?            @db.Date
  end_date             DateTime?            @db.Date
  description          String?
  visibility           Boolean?             @default(false)
  visibility_end_date  DateTime?            @db.Date
  status               status_enum          @default(Draft)
  max_slots            Int?
  location             String?
  visibility_timestamp DateTime?            @db.Timestamp(6)

  // Relations
  activities           Activity[]
  participants         Participant[]
  user                 User?                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  favorites            TravelPlanFavorite[]
  reviews              TravelPlanReview[]

  @@index([user_id], map: "idx_travel_plan_user_id")
  @@index([status], map: "idx_travel_plan_status")
  @@index([visibility], map: "idx_travel_plan_visibility")
  @@map("travel_plan")
}

model Activity {
  activity_id    Int         @id @default(autoincrement())
  travel_plan_id Int?
  business_id    Int?
  notes          String?
  target_date    DateTime?   @db.Date
  budget_range   range?
  user_id        Int?
  is_priority    Boolean?    @default(false)
  lat            Float?
  lng            Float?
  // Location fields
  name           String?     @db.VarChar(200)
  location       String?     @db.VarChar(300)
  brgy           String?     @db.VarChar(200)
  province       String?     @db.VarChar(200)
  city           String?     @db.VarChar(200)
  
  // Relations
  business       Business?   @relation(fields: [business_id], references: [business_id], onUpdate: NoAction)
  travel_plan    TravelPlan? @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade, onUpdate: NoAction)
  user           User?       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([travel_plan_id], map: "idx_activity_travel_plan_id")
  @@index([user_id], map: "idx_activity_user_id")
  @@index([business_id], map: "idx_activity_business_id")
  @@map("activity")
}

model Participant {
  participant_id Int              @id @default(autoincrement())
  travel_plan_id Int?
  user_id        Int?
  role           participant_role @default(Viewer)
  joined_at      DateTime?        @default(now()) @db.Timestamp(6)
  status         Boolean?         @default(false)
  
  // Relations
  travel_plan    TravelPlan?      @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade, onUpdate: NoAction)
  user           User?            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, travel_plan_id])
  @@index([travel_plan_id], map: "idx_participant_travel_plan_id")
  @@index([user_id], map: "idx_participant_user_id")
  @@map("participant")
}

model TravelPlanFavorite {
  favorite_id    Int         @id @default(autoincrement())
  user_id        Int?
  travel_plan_id Int?
  
  // Relations
  travel_plan    TravelPlan? @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade, onUpdate: NoAction)
  user           User?       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, travel_plan_id])
  @@map("travel_plan_favorite")
}

// Reviews
model BusinessReview {
  review_id   Int       @id @default(autoincrement())
  user_id     Int?
  business_id Int?
  rating      Decimal?  @db.Decimal(3, 1)
  content     String?
  review_date DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  
  // Relations
  business    Business? @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)
  user        User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("business_review")
}

model TravelPlanReview {
  review_id      Int         @id @default(autoincrement())
  user_id        Int?
  travel_plan_id Int?
  rating         Decimal?    @db.Decimal(3, 1)
  content        String?
  review_date    DateTime?   @default(dbgenerated("CURRENT_DATE")) @db.Date
  
  // Relations
  travel_plan    TravelPlan? @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade, onUpdate: NoAction)
  user           User?       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("travel_plan_review")
}
