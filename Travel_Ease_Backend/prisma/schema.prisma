// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum StatusEnum {
  Draft
  Active
  Completed
  Cancelled
}

enum ParticipantRole {
  Admin
  Editor
  Viewer
}

enum Range {
  RANGE_0_100      @map("0-100")
  RANGE_100_200    @map("100-200")
  RANGE_200_400    @map("200-400")
  RANGE_400_700    @map("400-700")
  RANGE_700_1000   @map("700-1000")
  RANGE_1000_1500  @map("1000-1500")
  RANGE_1500_PLUS  @map("1500+")
}

enum Category {
  food
  drinks
  accomodation
  souvenir_shop    @map("souvenir shop")
  nature
  night_life       @map("night life")
  leisure
  activities
  local_offers     @map("local offers")
}

// User and Authentication
model User {
  user_id              Int                   @id @default(autoincrement())
  first_name           String                @db.VarChar(100)
  last_name            String                @db.VarChar(100)
  email                String                @unique @db.VarChar(100)
  contact_no           String?               @db.VarChar(50)
  password             String

  // Relations
  blogs                Blog[]
  businesses           Business[]
  travel_plans         TravelPlan[]
  activities           Activity[]
  participants         Participant[]
  business_favorites   BusinessFavorite[]
  travel_plan_favorites TravelPlanFavorite[]
  business_reviews     BusinessReview[]
  travel_plan_reviews  TravelPlanReview[]

  @@map("user")
}

// Blog Content
model Blog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          Int?
  title            String    @db.VarChar(200)
  slug             String    @unique @db.VarChar(200)
  excerpt          String    @db.VarChar(500)
  content          String    @db.Text
  coverImageUrl    String
  category         String    @db.VarChar(100)
  isFeatured       Boolean   @default(false)
  readingMinutes   Int
  publishedAt      DateTime  @default(now())
  author           String    @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  // Relations
  user             User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([isFeatured])
  @@index([publishedAt])
  @@map("Blog")
}

// Business and Related Tables
model Business {
  business_id          Int                  @id @default(autoincrement())
  user_id              Int?
  name                 String               @db.VarChar(200)
  house_number         String?              @db.VarChar(300)
  street               String?              @db.VarChar(300)
  brgy                 String?              @db.VarChar(300)
  city                 String?              @db.VarChar(300)
  latitude             Float?               @db.DoublePrecision
  longtitude           Float?               @db.DoublePrecision
  description          String?              @db.Text
  rating               Decimal?             @db.Decimal(3, 1)
  google_authenticator String?              @db.VarChar(100)
  status               Boolean              @default(false)
  picture              String?

  // Relations
  user                 User?                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  categories           BusinessCategory[]
  favorites            BusinessFavorite[]
  business_hours       BusinessHours[]
  activities           Activity[]
  reviews              BusinessReview[]

  @@map("business")
}

model BusinessCategory {
  category_id    Int       @id @default(autoincrement())
  business_id    Int
  category_name  Category

  // Relations
  business       Business  @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  price_ranges   PriceRange[]

  @@map("business_category")
}

model BusinessFavorite {
  favorite_id  Int      @id @default(autoincrement())
  user_id      Int
  business_id  Int

  // Relations
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  business     Business @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@map("business_favorite")
}

model BusinessHours {
  id           Int       @id @default(autoincrement())
  business_id  Int
  day_of_week  String?   @db.VarChar(10)
  open_time    DateTime? @db.Time
  close_time   DateTime? @db.Time

  // Relations
  business     Business  @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@map("business_hours")
}

model PriceRange {
  id           Int               @id @default(autoincrement())
  category_id  Int?
  min_price    Int
  max_price    Int

  // Relations
  category     BusinessCategory? @relation(fields: [category_id], references: [category_id], onDelete: SetNull)

  @@map("price_range")
}

// Travel Plan and Related Tables
model TravelPlan {
  travel_plan_id        Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(200)
  user_id               Int
  start_date            DateTime?              @db.Date
  end_date              DateTime?              @db.Date
  description           String?                @db.Text
  visibility            Boolean                @default(false)
  visibility_end_date   DateTime?              @db.Date
  status                StatusEnum             @default(Draft)
  max_slots             Int?
  location              String?
  visibility_timestamp  DateTime?

  // Relations
  user                  User                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  activities            Activity[]
  participants          Participant[]
  favorites             TravelPlanFavorite[]
  reviews               TravelPlanReview[]

  @@map("travel_plan")
}

model Activity {
  activity_id      Int         @id @default(autoincrement())
  travel_plan_id   Int
  business_id      Int?
  notes            String?     @db.Text
  target_date      DateTime?   @db.Date
  budget_range     Range?
  user_id          Int
  is_priority      Boolean     @default(false)
  lat              Float?      @db.DoublePrecision
  lng              Float?      @db.DoublePrecision

  // Relations
  travel_plan      TravelPlan  @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade)
  business         Business?   @relation(fields: [business_id], references: [business_id], onDelete: SetNull)
  user             User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("activity")
}

model Participant {
  participant_id   Int              @id @default(autoincrement())
  travel_plan_id   Int
  user_id          Int
  role             ParticipantRole  @default(Viewer)
  joined_at        DateTime         @default(now())
  status           Boolean          @default(false)

  // Relations
  travel_plan      TravelPlan       @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("participant")
}

model TravelPlanFavorite {
  favorite_id      Int        @id @default(autoincrement())
  user_id          Int
  travel_plan_id   Int

  // Relations
  user             User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  travel_plan      TravelPlan @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade)

  @@map("travel_plan_favorite")
}

// Reviews
model BusinessReview {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  business_id  Int
  rating       Decimal?  @db.Decimal(3, 1)
  content      String?   @db.Text
  review_date  DateTime  @default(now()) @db.Date

  // Relations
  user         User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  business     Business  @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@map("business_review")
}

model TravelPlanReview {
  review_id      Int        @id @default(autoincrement())
  user_id        Int
  travel_plan_id Int
  rating         Decimal?   @db.Decimal(3, 1)
  content        String?    @db.Text
  review_date    DateTime   @default(now()) @db.Date

  // Relations
  user           User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  travel_plan    TravelPlan @relation(fields: [travel_plan_id], references: [travel_plan_id], onDelete: Cascade)

  @@map("travel_plan_review")
}

