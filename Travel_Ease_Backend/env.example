# ===============================================
# DATABASE CONFIGURATION (Required)
# ===============================================
# PostgreSQL connection string
# 
# Local PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/travelease_db"
# 
# Supabase (recommended for production):
# Get this from Supabase Dashboard > Settings > Database > Connection String (Session mode)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# 
# For connection pooling (Supavisor), use the Transaction mode connection string
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
DATABASE_URL="postgresql://username:password@localhost:5432/travelease_db"

# ===============================================
# SUPABASE CONFIGURATION (For Authentication)
# ===============================================
# Get these from Supabase Dashboard > Settings > API
# URL format: https://[PROJECT-REF].supabase.co
SUPABASE_URL="https://your-project.supabase.co"
# Anon key (safe to expose in frontend)
SUPABASE_ANON_KEY="your-anon-key-here"
# Service role key (keep secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ===============================================
# AUTHENTICATION MODE
# ===============================================
# "supabase" - Use Supabase Auth (recommended)
# "local" - Use local JWT with bcrypt (for development without Supabase)
AUTH_MODE="supabase"

# ===============================================
# JWT CONFIGURATION (For local auth mode or fallback)
# ===============================================
# Secret key for signing JWT tokens (generate a strong random string)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-key-change-in-production"

# ===============================================
# SERVER CONFIGURATION
# ===============================================
# Port for the unified backend server
PORT=3001

# Environment (development, production, test)
NODE_ENV=development

# ===============================================
# CLOUDINARY CONFIGURATION (Required for image uploads)
# ===============================================
# Get these credentials from your Cloudinary account dashboard
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ===============================================
# API SECURITY (Optional)
# ===============================================
# Secret key for protected routes (if implementing authentication)
API_KEY="your-secret-api-key-here"

# ===============================================
# NOTES
# ===============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. DATABASE_URL is required for Prisma to connect to PostgreSQL
# 4. CLOUDINARY credentials are required for image upload features
# 5. Run 'npx prisma generate' after setting DATABASE_URL
# 6. Run 'npx prisma db push' to create database tables
