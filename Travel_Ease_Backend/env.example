# ===============================================
# DATABASE CONFIGURATION (Required)
# ===============================================
# PostgreSQL connection string
# 
# Local PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/travelease_db"
# 
# Supabase (recommended for production):
# Get this from Supabase Dashboard > Settings > Database > Connection String (Session mode)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# 
# For connection pooling (Supavisor), use the Transaction mode connection string
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
DATABASE_URL="postgresql://username:password@localhost:5432/travelease_db"

# Direct database connection (Required for Prisma migrations when using connection pooling)
# This bypasses the connection pooler for schema changes
# 
# For Supabase: Use the direct connection (port 5432, db.* hostname)
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# For local development (same as DATABASE_URL):
DIRECT_URL="postgresql://username:password@localhost:5432/travelease_db"

# ===============================================
# SUPABASE CONFIGURATION (Required for Authentication & Storage)
# ===============================================
# Get these from Supabase Dashboard > Settings > API
# URL format: https://[PROJECT-REF].supabase.co
SUPABASE_URL="https://your-project.supabase.co"
# Anon key (safe to expose in frontend)
SUPABASE_ANON_KEY="your-anon-key-here"
# Service role key (keep secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ===============================================
# SUPABASE STORAGE (Required for image uploads)
# ===============================================
# Bucket name for image uploads (must be created as PUBLIC bucket in Supabase)
# Create via: Supabase Dashboard > Storage > New Bucket > Name: "images" > Public: ON
SUPABASE_STORAGE_BUCKET="images"

# ===============================================
# GOOGLE OAUTH (via Supabase)
# ===============================================
# Configure in Supabase Dashboard > Authentication > Providers > Google
# 1. Create OAuth credentials in Google Cloud Console
# 2. Add credentials to Supabase Google provider settings
# No env vars needed here - Supabase handles OAuth flow

# ===============================================
# JWT CONFIGURATION (For testing only)
# ===============================================
# Secret key for JWT tokens in test mode (NODE_ENV=test)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-key-for-testing"

# ===============================================
# SERVER CONFIGURATION
# ===============================================
# Port for the unified backend server
PORT=3001

# Environment (development, production, test)
NODE_ENV=development

# Allowed CORS origins (comma-separated)
# For development, localhost origins are allowed by default
# For production, add your frontend domains here
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ===============================================
# API SECURITY (Optional)
# ===============================================
# Secret key for API key authentication (x-api-key header)
API_KEY="your-secret-api-key-here"

# ===============================================
# MAP PROVIDER CONFIGURATION
# ===============================================
# Provider: nominatim (free, default) or mapbox
MAP_PROVIDER=nominatim

# Nominatim (OpenStreetMap) - free, 1 req/sec limit
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OSRM (routing) - free, no key needed
OSRM_BASE_URL=https://router.project-osrm.org

# Mapbox (optional, for production)
# Get token from https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your-mapbox-token
MAPBOX_BASE_URL=https://api.mapbox.com

# Rate limiting (requests per window)
MAP_RATE_LIMIT_WINDOW_MS=60000
MAP_RATE_LIMIT_MAX=30

# Cache TTL in seconds
CACHE_TTL_SEARCH=300
CACHE_TTL_GEOCODE=86400
CACHE_TTL_ROUTE=120

# ===============================================
# REDIS CONFIGURATION (Optional - for caching & rate limiting)
# ===============================================
# Enable/disable Redis (auto-enabled if REDIS_URL or REDIS_HOST is set)
REDIS_ENABLED=true

# Option 1: Full connection URL (recommended for production/cloud)
# Format: redis://[[username]:password@]host[:port][/database]
# Examples:
#   - Local: redis://localhost:6379/0
#   - With auth: redis://:yourpassword@localhost:6379/0
#   - Cloud (Redis Labs): redis://user:password@redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com:12345/0
REDIS_URL=redis://localhost:6379/0

# Option 2: Individual connection parameters (alternative to REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===============================================
# NOTES
# ===============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. DATABASE_URL is required for Prisma to connect to PostgreSQL
# 4. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required for authentication
# 5. SUPABASE_STORAGE_BUCKET is required for image uploads (create a public bucket in Supabase)
# 6. Run 'npx prisma generate' after setting DATABASE_URL
# 7. Run 'npx prisma db push' to create database tables
# 8. Redis is optional - the app works without it using in-memory caching
# 9. To disable Redis entirely, set REDIS_ENABLED=false
# 10. Images are now stored in Supabase Storage (not Cloudinary)
